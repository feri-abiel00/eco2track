{
  "hosting": [
    {
      "site": "terrastep",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "package.json",
        "package-lock.json",
        "firestore.rules",
        "storage.rules",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "headers": [
        {
          "source": "downloads/**",
          "headers": [
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        }
      ]
    },
    {
      "site": "eco2track-new",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "package.json",
        "package-lock.json",
        "firestore.rules",
        "storage.rules",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "headers": [
        {
          "source": "downloads/**",
          "headers": [
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        }
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
